# Browser-visible values. Set both as Docker build arguments in Coolify.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56021
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only key. Set as a runtime environment variable; never a build argument.
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Optional AI form creation for signed-in owners. Server runtime only.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini
